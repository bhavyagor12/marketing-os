# ===== Host-side port overrides =====
# Change these if a port is already in use on your machine.
# If you change POSTGRES_HOST_PORT, also update the port in DATABASE_URL below.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ===== Database =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketing_os

# ===== Redis (BullMQ + collab presence) =====
REDIS_URL=redis://localhost:6379

# ===== Better Auth =====
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000

# ===== Web app =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AGENTS_URL=http://localhost:8000
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234

# ===== Envelope encryption for BYO API keys =====
# Generate with: openssl rand -base64 32
KEY_ENCRYPTION_KEY=replace-with-base64-32-bytes

# ===== Agents service (Python) =====
AGENTS_PORT=8000
# Server-to-server URL (used by web server actions & worker). Same host as public in dev.
AGENTS_URL=http://localhost:8000
# Shared secret between web/worker and agents service (s2s auth)
AGENTS_INTERNAL_TOKEN=replace-with-shared-secret

# ===== Y-websocket collab server =====
COLLAB_PORT=1234

# ===== Social OAuth (fill after app approvals) =====
# X OAuth 2.0 (PKCE confidential client). Register at https://developer.x.com:
#   - Enable OAuth 2.0
#   - Callback: http://localhost:3000/api/connections/x/callback
#   - Scopes: tweet.read tweet.write users.read offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/connections/x/callback

# LinkedIn OAuth 2.0 — register at https://www.linkedin.com/developers:
#   - Auth type: OpenID Connect
#   - Redirect URL: http://localhost:3000/api/connections/linkedin/callback
#   - Scopes: openid profile email w_member_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/connections/linkedin/callback
# Meta (Facebook/Instagram) OAuth — register an app at https://developers.facebook.com:
#   - Product: Facebook Login for Business
#   - Valid OAuth redirect URI: http://localhost:3000/api/connections/meta/callback
#   - Request: instagram_basic, instagram_content_publish, pages_show_list,
#     pages_read_engagement, business_management
#   - Requires Meta App Review for production; dev mode works with test users.
#   - Also: the Instagram account must be Business/Creator and linked to a Facebook Page.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/connections/meta/callback

# Public base URL used in tracking links (the /t/ redirect + /p/ pixel endpoints).
# Swap to your deployed origin in prod.
TRACKING_BASE_URL=http://localhost:3000

# ===== Embeddings (Voyage) =====
# Optional — embeds brand_memory chunks and powers RAG at agent call time. BYO via
# Connections UI is preferred; this env var is only a dev fallback.
# Get a key: https://dash.voyageai.com/
VOYAGE_API_KEY=

# ===== Image generation (OpenAI) =====
# Used by the creative agent (DALL-E 3). BYO via Connections UI is preferred; this env
# var is only a dev fallback. Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ===== Video generation (HeyGen) =====
# Used by the creative agent for avatar-based video. BYO via Connections UI is preferred.
# Get a key: https://app.heygen.com/settings → API.
HEYGEN_API_KEY=
# Optional defaults — override per-request in the UI later.
HEYGEN_DEFAULT_AVATAR_ID=
HEYGEN_DEFAULT_VOICE_ID=

# ===== DODO Payments (managed plans) =====
# Dashboard: https://dodopayments.com → Developers → API keys
DODO_API_KEY=
DODO_API_BASE=https://live.dodopayments.com
# Product IDs from DODO dashboard — one per managed tier
DODO_PRODUCT_ID_MANAGED=
DODO_PRODUCT_ID_MANAGED_PRO=
# Webhook signing secret. Endpoint to register in DODO:
#   ${NEXT_PUBLIC_APP_URL}/api/webhooks/dodo
DODO_WEBHOOK_SECRET=

# ===== Email sending =====
RESEND_API_KEY=
# Webhook signing secret from Resend → Webhooks → your endpoint. Format: whsec_...
# Endpoint URL to register in Resend: ${TRACKING_BASE_URL}/api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# ===== Object storage (MinIO locally, S3 in prod) =====
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=marketing-os-media
S3_FORCE_PATH_STYLE=true
